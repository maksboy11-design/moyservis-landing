{
  "name": "moyservis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.mjs",
    "dev": "next dev --turbopack",
    "dev:mail": "concurrently -k -n web,mail \"next dev --turbopack\" \"tsx src/mail-worker.ts\"",
    "build": "next build",
    "build:mail-worker": "tsup src/mail-worker.ts --format esm --platform node --target node22 --out-dir dist --clean --external better-sqlite3 --external nodemailer",
    "rebuild": "npm run clean && next build",
    "prestart": "node scripts/assert-prod-build.mjs",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mail": "vitest run src/mail",
    "verify:mail": "npm run typecheck && npm run test:mail",
    "mail:worker": "tsx src/mail-worker.ts",
    "mail:health": "tsx src/mail/cli.ts health",
    "mail:test": "tsx src/mail/cli.ts test-send",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "next": "^15.5.0",
    "nodemailer": "^9.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.52.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "smtp-server": "^3.19.2",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
