# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_YM_ID=

# Server
SITE_URL=http://localhost:3000
PORT=3000

# MAX Bot (lead notifications) — server-only, never NEXT_PUBLIC_
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_RECIPIENT=chat
MAX_API_BASE_URL=https://platform-api.max.ru
NOTIFY_TIMEOUT_MS=8000
NOTIFY_RETRIES=2

# Mail sender identity
MAIL_ENABLED=false
MAIL_FROM="Мой Сервис <no-reply@example.com>"
MAIL_REPLY_TO=service@example.com
MAIL_ADMIN_TO=service@example.com

# SMTP; Docker Compose overrides host to the Mailpit service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

# Persistent SQLite queue shared by web and worker
MAIL_QUEUE_PATH=./data/mail-queue.sqlite
MAIL_WORKER_CONCURRENCY=4
MAIL_POLL_INTERVAL_MS=1000
MAIL_LEASE_MS=60000
MAIL_MAX_ATTEMPTS=8
MAIL_BASE_RETRY_MS=5000
MAIL_MAX_RETRY_MS=3600000
MAIL_RETENTION_MS=604800000

# Protect maintenance/test-mail endpoints if they are enabled.
# Generate a long random value in the deployment secret store.
MAIL_HEALTH_TOKEN=
MAIL_HEALTH_TIMEOUT_MS=5000
